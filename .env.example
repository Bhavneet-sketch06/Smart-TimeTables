# Copy this file to .env.local and fill in the values. .env.local is git-ignored: never commit it.
# Setup guide: docs/SUPABASE_SETUP.md

# --- Supabase (sign-in and shared college data) ---
# Supabase Dashboard -> Project Settings -> API (or "Connect"): the Project URL and the PUBLISHABLE key.
# Both are public by design; Row Level Security in the database protects the data.
# NEVER put the secret / service_role key here or in any VITE_ variable: Vite copies VITE_ values into the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- AI assistant (server only) ---
# Your Claude API key (https://console.anthropic.com). No VITE_ prefix, so it never reaches the browser.
ANTHROPIC_API_KEY=

# --- Optional ---
# Without the Supabase values above, `npm run dev` runs the old browser-only demo (role picker, no accounts).
# A production build shows a "not set up" screen instead, unless you opt in to the demo explicitly:
# VITE_LOCAL_DEMO=true
